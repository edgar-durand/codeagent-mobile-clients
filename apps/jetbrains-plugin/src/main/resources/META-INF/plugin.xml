<idea-plugin package="com.windsurf.controller">
    <id>com.codeagent.mobile</id>
    <name>CodeAgent-Mobile</name>
    <version>2.10.8</version>
    <vendor email="support@codeagent-mobile.com" url="https://www.codeagent-mobile.com">
        CodeAgent-Mobile
    </vendor>

    <description><![CDATA[
    <b>The workflow-continuity bridge for AI coding agents.</b>
    Supervise, approve, and redirect the agents running in your JetBrains IDE
    from any device — async.

    <br/><br/>
    AI agents now run for hours, not seconds. Most developer workflows still pin
    you to a single screen while that happens. This plugin turns your IDE into
    the agent's home base — the agent keeps writing, refactoring, and shipping
    while a paired phone or browser becomes your remote checkpoint.

    <br/><br/>
    <b>Homepage:</b> <a href="https://www.codeagent-mobile.com">https://www.codeagent-mobile.com</a>

    <br/><br/>
    <b>What you can do remotely:</b>
    <ul>
        <li>Stay in the loop while a long refactor builds</li>
        <li>Approve diffs, redirect prompts, or course-correct from anywhere</li>
        <li>Hand off work between devices without breaking the session</li>
        <li>Share live agent sessions with teammates in Team Spaces</li>
        <li>Spin up GitHub Codespaces with Claude Code preinstalled</li>
    </ul>

    <br/>
    <b>Works with the agents already in your IDE:</b>
    <ul>
        <li>Claude Code (Anthropic)</li>
        <li>OpenAI Codex</li>
        <li>GitHub Copilot Chat</li>
        <li>JetBrains AI Assistant</li>
        <li>Windsurf / Cascade (Codeium)</li>
        <li>Cursor</li>
    </ul>

    <br/>
    <b>Get the Companion App:</b>
    <ul>
        <li><b>Mobile App</b> (recommended) — App Store or Play Store</li>
        <li><b>Web Dashboard</b> — <a href="https://www.codeagent-mobile.com/dashboard">codeagent-mobile.com/dashboard</a> (no install)</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="terminal-support.xml">org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="CodeAgent-Mobile"
                    secondary="true"
                    icon="/icons/app-icon-tw.svg"
                    anchor="right"
                    factoryClass="com.windsurf.controller.ui.ControllerToolWindowFactory"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.SettingsService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.PairingService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.CommandRelayService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.IdeIntegrationService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.AgentOutputMonitor"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.McpConfigWriterService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.FileOpsService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.ProjectOpsService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.FileWatcherService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.TelemetryService"/>
        <applicationService
                serviceImplementation="com.windsurf.controller.services.UpdateNotifierService"/>
        <postStartupActivity
                implementation="com.windsurf.controller.services.FileWatcherStartupActivity"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.windsurf.controller.settings.ControllerConfigurable"
                id="com.codeagent.mobile.settings"
                displayName="CodeAgent-Mobile"/>
        <notificationGroup id="CodeAgent-Mobile"
                           displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="WindsurfController.ActionGroup"
               text="CodeAgent Mobile"
               description="CodeAgent Mobile actions"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="WindsurfController.ShowPairingCode"
                    class="com.windsurf.controller.actions.ShowPairingCodeAction"
                    text="Show Pairing Code"
                    description="Display a pairing code for mobile device connection"
                    icon="/icons/pair.svg"/>
            <action id="WindsurfController.Disconnect"
                    class="com.windsurf.controller.actions.DisconnectAction"
                    text="Disconnect Mobile"
                    description="Disconnect the paired mobile device"/>
        </group>
    </actions>
</idea-plugin>
