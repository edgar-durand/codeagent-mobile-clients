{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    // `bundler` resolution honors the `exports` field in dependency
    // package.json without forcing us to flip `module` to node16
    // (which would re-shape every relative import). Most modern
    // npm packages ship via `exports` without a legacy `main`, so
    // this future-proofs us against an import that worked locally
    // but failed at typecheck. tsup does its own bundling
    // resolution, so this is purely a type-checking concern.
    "moduleResolution": "bundler",
    // `@codeam/shared` type-checks against its workspace SOURCE (via the
    // root node_modules workspace symlink, which keeps TS treating it as an
    // external library — a bare ../../packages path would pull it under
    // this project's `rootDir` and fail TS6059), not the
    // built `dist/` its publishable manifest points at — typecheck must
    // not depend on `packages/shared` having been built. Mirrors the
    // bundler alias in tsup.config.ts and the vitest `resolve.alias`.
    "paths": {
      "@codeam/shared": ["../../node_modules/@codeam/shared/src/index.ts"]
    },
    "ignoreDeprecations": "6.0",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
