{
  "name": "codeagent-mobile",
  "displayName": "CodeAgent — Remote AI Supervision",
  "description": "The workflow-continuity bridge for AI coding agents. Supervise, approve, and redirect Claude Code, Copilot, Cursor, and other agents in this editor from any device — async.",
  "version": "2.11.0",
  "publisher": "CodeAgentMobile",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#A855F7",
    "theme": "dark"
  },
  "preview": false,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "ai-workflow",
    "ai-workflow-continuity",
    "async-ai-productivity",
    "remote-ai-supervision",
    "claude",
    "claude-code",
    "copilot",
    "cursor",
    "windsurf",
    "agent-operations",
    "developer-tools",
    "codeagent",
    "mcp"
  ],
  "homepage": "https://www.codeagent-mobile.com",
  "bugs": {
    "url": "https://github.com/edgar-durand/codeagent-mobile-clients/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edgar-durand/codeagent-mobile-clients"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/CodeAgentMobile.codeagent-mobile?color=A855F7&label=VS%20Code%20Marketplace",
      "href": "https://marketplace.visualstudio.com/items?itemName=CodeAgentMobile.codeagent-mobile",
      "description": "VS Code Marketplace version"
    },
    {
      "url": "https://img.shields.io/open-vsx/v/CodeAgentMobile/codeagent-mobile?color=A855F7&label=Open%20VSX",
      "href": "https://open-vsx.org/extension/CodeAgentMobile/codeagent-mobile",
      "description": "Open VSX version"
    }
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/edgar-durand"
  },
  "qna": "https://github.com/edgar-durand/codeagent-mobile-clients/issues",
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeagent-mobile",
          "title": "CodeAgent Mobile",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codeagent-mobile": [
        {
          "type": "webview",
          "id": "codeagent-mobile.panel",
          "name": "CodeAgent Mobile"
        }
      ]
    },
    "commands": [
      {
        "command": "codeagent-mobile.showPairingCode",
        "title": "CodeAgent Mobile: Show Pairing Code"
      },
      {
        "command": "codeagent-mobile.disconnect",
        "title": "CodeAgent Mobile: Disconnect"
      },
      {
        "command": "codeagent-mobile.openPanel",
        "title": "CodeAgent Mobile: Open Panel"
      }
    ],
    "configuration": {
      "title": "CodeAgent Mobile",
      "properties": {
        "codeagent-mobile.apiBaseUrl": {
          "type": "string",
          "default": "https://api.codeagent-mobile.com",
          "description": "API base URL for the CodeAgent Mobile backend"
        },
        "codeagent-mobile.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reconnect to the last paired session"
        },
        "codeagent-mobile.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification messages"
        },
        "codeagent-mobile.heartbeatIntervalMs": {
          "type": "number",
          "default": 30000,
          "description": "Heartbeat interval in milliseconds"
        },
        "codeagent-mobile.telemetryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Send anonymous usage events to PostHog. Disabled automatically when VS Code's global telemetry setting is off. See https://github.com/edgar-durand/codeagent-mobile-clients#telemetry"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test:e2e": "npm run build && npm run build:test && node ./dist-test/test/runTest.js"
  },
  "devDependencies": {
    "@codeagent/shared": "*",
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "posthog-node": "^5.35.1",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
